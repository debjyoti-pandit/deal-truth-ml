# Deal Truth ML — copy to .env (`cp .env.example .env`). Never commit real tokens.
#
# LOCAL (make up): ML on :8081, ngrok inspector :4041 (API uses :4040).
# deal-truth Docker API talks to http://host.docker.internal:8081 (already in API .env.example).
#
# YOU MUST FILL:
#   NGROK_AUTHTOKEN — same account as the API is fine
#   NGROK_DOMAIN — a *different* Dev Domain than the API (https://dashboard.ngrok.com/domains)
# Cloudflare: `make login` on the host is enough for Docker; or set CLOUDFLARE_API_TOKEN.
#
# Production Worker: wrangler.jsonc vars + `wrangler secret put INTERNAL_API_TOKEN`
# See .env.production.example and docs/DEPLOYMENT.md

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

ML_PORT=8081

NGROK_AUTHTOKEN=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
NGROK_INSPECTOR_PORT=4041
NGROK_UPSTREAM=http://ml:8081
