# Deal Truth ML — copy to .env (`cp .env.example .env`). Never commit real tokens.
#
# LOCAL (make up): ML on :8081, ngrok inspector :4041 (API uses :4040).
# APP_NAME drives the reserved Dev Domain: {APP_NAME}-ngrok.ngrok-free.app
# (API uses APP_NAME=deal-truth-api and NGROK_DOMAIN=deal-truth-ngrok.ngrok-free.app).
# Claim this hostname at https://dashboard.ngrok.com/domains — it MUST differ from the API.
#
# Docker API on the same machine: ML_SERVICE_BASE_URL=http://host.docker.internal:8081
# Remote API: ML_SERVICE_BASE_URL=https://deal-truth-ml-ngrok.ngrok-free.app
#
# YOU MUST FILL: NGROK_AUTHTOKEN (same account as the API is fine).
# Cloudflare: `make login` on the host, or set CLOUDFLARE_API_TOKEN.
# See .env.production.example and docs/DEPLOYMENT.md

APP_NAME=deal-truth-ml

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

ML_PORT=8081

NGROK_AUTHTOKEN=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=deal-truth-ml-ngrok.ngrok-free.app
NGROK_INSPECTOR_PORT=4041
NGROK_UPSTREAM=http://ml:8081
