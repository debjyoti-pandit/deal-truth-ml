# Docker Compose / host env for this repo. Copy to .env. Never commit real tokens.
# Model IDs already live in wrangler.jsonc — you do not need to repeat them here.

# Required for `make up` (Docker wrangler). Create at:
# https://dash.cloudflare.com/profile/api-tokens
# Use a token with Workers Scripts Edit + Workers AI.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Host port published by docker compose (API expects 8081).
ML_PORT=8081
